{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hermix-push",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "account_id": "435aeeb78e5fe09c8e8eae423861cfb1",
  "workers_dev": true,
  "kv_namespaces": [
    { "binding": "hermex_relay", "id": "1e215e6b69ac43799e555993d25589d2" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "INSTALLS", "class_name": "InstallCoordinator" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["InstallCoordinator"] }],
  "vars": { "APNS_KEY_ID": "42238859UX", "APNS_TEAM_ID": "W2AMT84LS7" },
  // The URL contains a capability. Do not persist automatic request/invocation logs.
  "observability": { "enabled": false }
}
